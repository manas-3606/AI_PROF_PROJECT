datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. Platform & Tenant Governance
// -----------------------------------------------------------------------------
model Platform {
  id          String   @id @default(uuid())
  name        String   @default("AI.Prof Healthcare Platform")
  version     String   @default("2.0.0")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hospital {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, SUSPENDED
  address         String
  city            String
  operatingHours  String
  contactEmail    String
  contactPhone    String
  specialtiesJson String   @default("[]") // JSON array of specialty names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                  User[]
  departments            Department[]
  doctors                Doctor[]
  calendars              Calendar[]
  workingHours           WorkingHour[]
  blockedSlots           BlockedSlot[]
  slots                  Slot[]
  appointments           Appointment[]
  appointmentHistories   AppointmentStateHistory[]
  questionnaires         Questionnaire[]
  questionnaireResponses QuestionnaireResponse[]
  integrations           HealthcareSystemConnection[]
  externalMappings       ExternalIdentifierMapping[]
  integrationOperations  IntegrationOperation[]
  verifications          IntegrationVerification[]
  reconciliationRecords  ReconciliationRecord[]
  workflows              Workflow[]
  workflowExecutions     WorkflowExecution[]
  notifications          Notification[]
  conversations          AiConversation[]
  capabilityExecutions   CapabilityExecution[]
  aiEvaluations          AiEvaluation[]
  auditEvents            AuditEvent[]
  operationalEvents      OperationalEvent[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // PLATFORM_ADMIN, HOSPITAL_ADMIN, HOSPITAL_STAFF, DOCTOR, PATIENT
  hospitalId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital    Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor      Doctor?
  patient     Patient?
  auditEvents AuditEvent[]

  @@index([hospitalId])
  @@index([role])
}

model Department {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors  Doctor[]

  @@index([hospitalId])
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  doctors     Doctor[]
}

model Doctor {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  hospitalId                 String
  departmentId               String?
  specialtyId                String?
  name                       String
  specialty                  String
  department                 String
  qualifications             String
  experienceYears            Int      @default(5)
  languagesJson              String   @default("[\"English\"]")
  consultationTypesJson      String   @default("[\"In-Person\",\"Telehealth\"]")
  appointmentDurationMinutes Int      @default(30)
  status                     String   @default("ACTIVE") // INVITED, ACTIVE, INACTIVE, SUSPENDED
  photoUrl                   String?
  externalProviderId         String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  dept         Department?   @relation(fields: [departmentId], references: [id])
  spec         Specialty?    @relation(fields: [specialtyId], references: [id])
  calendar     Calendar?
  slots        Slot[]
  appointments Appointment[]

  @@index([hospitalId])
  @@index([status])
  @@index([specialty])
}

// -----------------------------------------------------------------------------
// 2. Calendars, Availability & Slots (Scheduling Domain)
// -----------------------------------------------------------------------------
model Calendar {
  id          String   @id @default(uuid())
  doctorId    String   @unique
  hospitalId  String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  workingHours WorkingHour[]
  blockedSlots BlockedSlot[]

  @@index([hospitalId])
}

model WorkingHour {
  id         String   @id @default(uuid())
  calendarId String
  hospitalId String?
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime  String   // "09:00"
  endTime    String   // "17:00"

  calendar Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([calendarId])
  @@index([hospitalId])
}

model BlockedSlot {
  id         String   @id @default(uuid())
  calendarId String
  hospitalId String?
  startTime  DateTime
  endTime    DateTime
  reason     String?

  calendar Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([calendarId])
  @@index([hospitalId])
}

model Slot {
  id         String   @id @default(uuid())
  doctorId   String
  hospitalId String
  startTime  DateTime
  endTime    DateTime
  isBooked   Boolean  @default(false)
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([doctorId, startTime])
  @@index([doctorId, startTime, isBooked])
  @@index([hospitalId])
}

// -----------------------------------------------------------------------------
// 3. Patient Management & User Context/Preferences
// -----------------------------------------------------------------------------
model Patient {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  name                    String
  phone                   String   @unique
  email                   String?
  dateOfBirth             String?
  communicationPreference String   @default("sms") // sms, email, in_app
  externalPatientId       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences            UserPreference?
  appointments           Appointment[]
  questionnaireResponses QuestionnaireResponse[]
  conversations          AiConversation[]

  @@index([phone])
}

model UserPreference {
  id                   String   @id @default(uuid())
  patientId            String   @unique
  hospitalId           String?
  communicationChannel String   @default("sms")
  preferredDaysJson    String   @default("[]")
  preferredTimeOfDay   String   @default("morning") // morning, afternoon, evening
  languagePreference   String   @default("en")
  specialRequirements  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

// -----------------------------------------------------------------------------
// 4. Appointments & Transactional State History (PRD Section 14 & 23)
// -----------------------------------------------------------------------------
model Appointment {
  id                    String   @id @default(uuid())
  patientId             String
  doctorId              String
  hospitalId            String
  slotId                String
  startTime             DateTime
  endTime               DateTime
  status                String   @default("Pending") // Requested, Pending, Confirmed, Rescheduled, Cancelled, Completed, No-show, Failed, Synchronization Pending, Reconciliation Required
  reason                String?
  externalAppointmentId String?
  idempotencyKey        String?  @unique
  correlationId         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient                Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                 Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital               Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  slot                   Slot                     @relation(fields: [slotId], references: [id])
  stateHistories         AppointmentStateHistory[]
  verifications          IntegrationVerification[]
  reconciliations        ReconciliationRecord[]
  workflowExecutions     WorkflowExecution[]
  questionnaireResponses QuestionnaireResponse[]

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
}

model AppointmentStateHistory {
  id            String   @id @default(uuid())
  appointmentId String
  hospitalId    String
  fromStatus    String
  toStatus      String
  reason        String?
  actorId       String?
  actorRole     String?
  correlationId String?
  changedAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([hospitalId])
  @@index([changedAt])
}

// -----------------------------------------------------------------------------
// 5. Pre-Visit Questionnaires
// -----------------------------------------------------------------------------
model Questionnaire {
  id              String   @id @default(uuid())
  hospitalId      String
  title           String
  description     String?
  specialty       String?
  doctorId        String?
  appointmentType String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital  Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  questions QuestionnaireQuestion[]
  responses QuestionnaireResponse[]

  @@index([hospitalId])
  @@index([doctorId])
  @@index([specialty])
  @@index([appointmentType])
}

model QuestionnaireQuestion {
  id              String  @id @default(uuid())
  questionnaireId String
  text            String
  type            String  // yes_no, choice, multiple_choice, numeric, date, short_text, long_text, structured
  required        Boolean @default(true)
  optionsJson     String? // JSON array of choice options or structured field specs
  orderIndex      Int     @default(0)

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model QuestionnaireResponse {
  id              String   @id @default(uuid())
  questionnaireId String
  appointmentId   String
  patientId       String
  hospitalId      String?
  answersJson     String   // JSON map of questionId -> answer
  flaggedUrgent   Boolean  @default(false)
  flaggedReason   String?
  submittedAt     DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital      Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([patientId])
  @@index([hospitalId])
  @@index([flaggedUrgent])
}

// -----------------------------------------------------------------------------
// 6. Conversational AI, Context & Capabilities (PRD Section 10 & 23)
// -----------------------------------------------------------------------------
model AiConversation {
  id           String   @id @default(uuid())
  patientId    String?
  hospitalId   String?
  channel      String   @default("web_voice") // web_voice, telephone
  startTime    DateTime @default(now())
  lastActivity DateTime @default(now())

  patient     Patient?              @relation(fields: [patientId], references: [id])
  hospital    Hospital?             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  context     AiContext?
  executions  CapabilityExecution[]
  evaluations AiEvaluation[]

  @@index([patientId])
  @@index([hospitalId])
}

model AiContext {
  id                  String   @id @default(uuid())
  conversationId      String   @unique
  currentIntent       String?
  selectedHospitalId  String?
  selectedDoctorId    String?
  selectedSlotId      String?
  activeAppointmentId String?
  contextJson         String   @default("{}") // Structured memory snapshot
  updatedAt           DateTime @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Capability {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  category      String   // SCHEDULING, DISCOVERY, INTEGRATION, COMMUNICATION, WORKFLOW
  riskLevel     String   @default("LOW") // READ_ONLY, LOW, MEDIUM, HIGH
  isAiCallable  Boolean  @default(true)
  schemaVersion String   @default("1.0.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CapabilityExecution {
  id             String   @id @default(uuid())
  conversationId String?
  hospitalId     String?
  capabilityName String
  inputJson      String
  outputJson     String?
  status         String   // SUCCESS, FAILED
  error          String?
  durationMs     Int      @default(0)
  correlationId  String?
  createdAt      DateTime @default(now())

  conversation AiConversation? @relation(fields: [conversationId], references: [id])
  hospital     Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([capabilityName])
  @@index([correlationId])
  @@index([hospitalId])
}

// -----------------------------------------------------------------------------
// 7. Integrations, Verification & Reconciliation (PRD Section 17, 18, 22, 23)
// -----------------------------------------------------------------------------
model HealthcareSystemConnection {
  id          String   @id @default(uuid())
  hospitalId  String
  systemType  String   @default("MOCK_EHR") // MOCK_EHR, EPIC_FHIR, CERNER
  baseUrl     String
  status      String   @default("ACTIVE")
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital   Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  operations IntegrationOperation[]

  @@index([hospitalId])
}

model ExternalIdentifierMapping {
  id         String   @id @default(uuid())
  hospitalId String   // tenant isolation
  tenantId   String?  // backwards-compatibility alias
  entityType String   // PATIENT, DOCTOR, APPOINTMENT, FACILITY
  internalId String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, entityType, internalId])
  @@unique([hospitalId, entityType, externalId])
  @@index([hospitalId, entityType])
}

model IntegrationOperation {
  id            String   @id @default(uuid())
  connectionId  String
  hospitalId    String
  operationType String   // APPOINTMENT_CREATE, APPOINTMENT_VERIFY, etc.
  status        String   // SUCCESS, FAILED, TIMEOUT, UNKNOWN_OUTCOME
  requestJson   String?
  responseJson  String?
  error         String?
  correlationId String?
  createdAt     DateTime @default(now())

  connection HealthcareSystemConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  hospital   Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([correlationId])
}

model IntegrationVerification {
  id             String   @id @default(uuid())
  appointmentId  String
  hospitalId     String
  isVerified     Boolean
  externalStatus String
  match          Boolean
  verifiedAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([hospitalId])
}

model ReconciliationRecord {
  id                  String    @id @default(uuid())
  appointmentId       String
  hospitalId          String
  reason              String
  externalSystemId    String
  externalRecordFound Boolean   @default(false)
  attemptCount        Int       @default(1)
  status              String    @default("OPEN") // OPEN, RESOLVED, ESCALATED
  escalatedTo         String?
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([hospitalId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 8. Workflows & Notifications (PRD Section 22 & 23)
// -----------------------------------------------------------------------------
model Workflow {
  id           String   @id @default(uuid())
  hospitalId   String
  type         String   // PreVisitQuestionnaire, AppointmentReminder, ReconciliationSync
  triggerEvent String
  configJson   String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital   Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([hospitalId])
}

model WorkflowExecution {
  id            String    @id @default(uuid())
  workflowId    String
  appointmentId String?
  hospitalId    String?
  status        String    @default("Active") // Active, Scheduled, Running, Completed, Failed, Retried
  payloadJson   String    @default("{}")
  error         String?
  attemptCount  Int       @default(0)
  scheduledAt   DateTime  @default(now())
  executedAt    DateTime?

  workflow    Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  hospital    Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([hospitalId])
  @@index([status])
}

model Notification {
  id            String   @id @default(uuid())
  hospitalId    String?
  recipientId   String
  recipientType String   // Patient, Doctor, HospitalAdmin
  channel       String   // sms, email, in_app
  templateId    String
  payloadJson   String
  status        String   @default("Queued") // Queued, Delivered, Failed
  createdAt     DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([hospitalId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 9. Observability, AI Evaluation & Audit (PRD Section 22 & 23)
// -----------------------------------------------------------------------------
model AiEvaluation {
  id             String   @id @default(uuid())
  conversationId String
  hospitalId     String?
  metric         String
  score          Float
  feedback       String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  hospital     Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([hospitalId])
}

model AuditEvent {
  id            String   @id @default(uuid())
  correlationId String
  hospitalId    String?
  tenantId      String?
  actorId       String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String?
  detailsJson   String?
  timestamp     DateTime @default(now())

  user     User?     @relation(fields: [actorId], references: [id])
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([correlationId])
  @@index([hospitalId])
  @@index([tenantId])
  @@index([action])
  @@index([timestamp])
}

model OperationalEvent {
  id            String   @id @default(uuid())
  correlationId String?
  hospitalId    String?
  tenantId      String?
  eventType     String
  severity      String   // INFO, WARN, ERROR, CRITICAL
  message       String
  detailsJson   String?
  timestamp     DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([correlationId])
  @@index([hospitalId])
  @@index([tenantId])
  @@index([severity])
}
