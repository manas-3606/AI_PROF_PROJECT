# ==============================================================================
# AI.Prof Healthcare Platform - Environment Configuration Example
# Copy this file to .env before starting services. None of the secrets are hardcoded.
# ==============================================================================

# 1. Database Configuration
# Local default uses zero-config SQLite; swap to PostgreSQL for Docker / Production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/health_platform?schema=public"

# 2. Cache & Queue (Redis / BullMQ)
# Leave empty for embedded in-process memory queue; set for Docker / Production
REDIS_URL=""
# REDIS_URL="redis://localhost:6379"

# 3. Microservice Ports & Base URLs
API_PORT=3001
VOICE_GATEWAY_PORT=3002
MOCK_EHR_PORT=4000
WEB_PORT=5173

API_BASE_URL="http://localhost:3001"
VOICE_GATEWAY_WS_URL="ws://localhost:3002"
MOCK_EHR_URL="http://localhost:4000"
MOCK_EHR_API_KEY="mock-ehr-prototype-api-key"

# 4. Authentication & Security
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars"

# 5. AI Reasoning & LLM Provider Keys
# Google Gemini API key for clinical dialog, function calling, and structured outputs
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional alternative LLM provider fallback
OPENAI_API_KEY=""

# 6. Real-Time Voice, Telephony & Audio Provider Keys
# Twilio credentials for inbound/outbound telephony trunking
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15550001234"

# Optional LiveKit WebRTC credentials
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Optional Speech-to-Text (STT) & Text-to-Speech (TTS) keys
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""

# 7. System Runtime & Logging Configuration
# Runtime environment: 'development' (default, enables verbose SQL and debug logs) or 'production'
NODE_ENV="development"

# Structured logging level: 'trace' | 'debug' | 'info' (default) | 'warn' | 'error' | 'fatal'
# Automatically applies regex PHI sanitization filters regardless of configured level
LOG_LEVEL="info"
