# ==============================================================================
# AI.Prof Healthcare Platform - Environment Configuration Example
# Copy this file to .env before starting services. None of the secrets are hardcoded.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED FOR PRODUCTION]: Managed PostgreSQL (e.g. Supabase Free Tier)
# Use the direct connection string (port 5432) or transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# [LOCAL DEVELOPMENT ALTERNATIVE]: Zero-config embedded SQLite
# If using SQLite locally, run `pnpm db:generate:sqlite`
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (services/api-server)
# ------------------------------------------------------------------------------
# [PRODUCTION]: Automatically assigned by Render (process.env.PORT)
# [LOCAL]: Port fallback
PORT=3001
API_PORT=3001
NODE_ENV="production" # Use "development" locally

# [REQUIRED FOR PRODUCTION]: Allowed Frontend Origins for CORS
# In production on Render, set this to your Render Static Site URL:
FRONTEND_URL="https://ai-prof-web.onrender.com"
# Local development default:
# FRONTEND_URL="http://localhost:5173"

# [REQUIRED]: JWT secret for authenticating healthcare platform users (min 32 chars)
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars-change-me"

# ------------------------------------------------------------------------------
# 3. AI REASONING & LLM (Gemini API)
# ------------------------------------------------------------------------------
# [REQUIRED]: Google Gemini API key for clinical dialog, function calling, & intake
# Obtain for free at: https://aistudio.google.com/app/apikey
# NEVER expose this key to the frontend. Loaded strictly on the backend.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. MICROSERVICE INTERCONNECTIVITY (Render Web Services)
# ------------------------------------------------------------------------------
# Mock EHR service URL
# Production: Set to your deployed Mock EHR Render Web Service URL
MOCK_EHR_URL="https://ai-prof-mock-ehr.onrender.com"
# Local development default:
# MOCK_EHR_URL="http://localhost:4000"
MOCK_EHR_PORT=4000

# Voice Gateway WebSocket service URL
# Production: Set to your deployed Voice Gateway Render Web Service URL
VOICE_GATEWAY_URL="https://ai-prof-voice-gateway.onrender.com"
# Local development default:
# VOICE_GATEWAY_URL="http://localhost:3002"
VOICE_GATEWAY_PORT=3002

# ------------------------------------------------------------------------------
# 5. WEB FRONTEND (apps/web - Render Static Site Environment Variables)
# ------------------------------------------------------------------------------
# These variables MUST be set in the Render Static Site Environment settings:
# VITE_API_BASE_URL: Target URL of the deployed Fastify backend
VITE_API_BASE_URL="https://ai-prof-api.onrender.com/api"
# VITE_VOICE_GATEWAY_WS_URL: Target WebSocket URL of the deployed Voice Gateway (optional)
VITE_VOICE_GATEWAY_WS_URL="wss://ai-prof-voice-gateway.onrender.com"

# ------------------------------------------------------------------------------
# 6. CACHE & QUEUE (Redis / BullMQ) - OPTIONAL
# ------------------------------------------------------------------------------
# Leave EMPTY for free deployment! An embedded in-process async queue is automatically
# used when REDIS_URL is not set. No Redis instance is required for the demo.
REDIS_URL=""
# Production Redis (e.g. Upstash free Redis or Redis Cloud free tier, optional):
# REDIS_URL="rediss://default:[password]@[endpoint]:6379"

# ------------------------------------------------------------------------------
# 7. TELEPHONY & LIVE AUDIO - OPTIONAL
# ------------------------------------------------------------------------------
# Twilio credentials for inbound/outbound telephony trunking (optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional LiveKit WebRTC credentials
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Optional Speech-to-Text & Text-to-Speech keys
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""

# ------------------------------------------------------------------------------
# 8. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
