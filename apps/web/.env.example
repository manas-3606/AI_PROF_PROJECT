# AI.Prof Healthcare Platform - Web Frontend (.env.example)
#
# Production (Render Static Site Environment Variables):
# Set these in the Render Dashboard under Static Site > Environment
#
# VITE_API_BASE_URL: Full URL to the deployed Fastify backend
# Example: VITE_API_BASE_URL="https://ai-prof-api.onrender.com/api"
VITE_API_BASE_URL="http://localhost:3001/api"

# VITE_VOICE_GATEWAY_WS_URL: Full WebSocket URL to the deployed Voice Gateway service (optional)
# Example: VITE_VOICE_GATEWAY_WS_URL="wss://ai-prof-voice-gateway.onrender.com"
VITE_VOICE_GATEWAY_WS_URL="ws://localhost:3002"
