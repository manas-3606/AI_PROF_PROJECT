# AI.Prof Healthcare Platform - Web Frontend (.env.example)
#
# Production (Render Static Site Environment Variables):
# Set these in the Render Dashboard under Static Site > Environment
#
# VITE_API_BASE_URL: Target path or URL for backend API
VITE_API_BASE_URL="/api"

# VITE_VOICE_GATEWAY_WS_URL: Full WebSocket URL to the deployed Voice Gateway service
VITE_VOICE_GATEWAY_WS_URL="wss://ai-prof-voice-gateway.onrender.com/ws/voice"

# Local Development Defaults:
# VITE_API_BASE_URL="http://localhost:3001/api"
# VITE_VOICE_GATEWAY_WS_URL="ws://localhost:3002/ws/voice"
